    matrix_cols: 32,

    temp_dim_in: 1,  // matrix channels
    temp_dim_out: 1, 

    systolic_dim: 32,  // systolic array size

    tempLoop0_in: 8,
    tempLoop1_in: 32,
    tempLoop2_in: 1,
    tempLoop3_in: 1,
    tempLoop4_in: 1,
    tempLoop5_in: 1,

    tempStride0_in: 2048,
    tempStride1_in: 264,
    tempStride2_in: 0,
    tempStride3_in: 0,
    tempStride4_in: 0,
    tempStride5_in: 0,

    tempLoop0_out: 8,
    tempLoop1_out: 8,
    tempLoop2_out: 4,
    tempLoop3_out: 1,
    tempLoop4_out: 1,
    tempLoop5_out: 1,

    tempStride0_out: 512,
    tempStride1_out: 8,
    tempStride2_out: 4096,
    tempStride3_out: 0,
    tempStride4_out: 0,
    tempStride5_out: 0,

    spatialStride_in: 256,
    spatialStride_out: 64


}