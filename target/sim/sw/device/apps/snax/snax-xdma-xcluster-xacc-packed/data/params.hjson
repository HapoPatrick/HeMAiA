    tempLoop3_in: 16,
    tempLoop4_in: 1,
    tempLoop5_in: 1,

    tempStride0_in: 64,
    tempStride1_in: 2048,
    tempStride2_in: 128,
    tempStride3_in: 4096,
    tempStride4_in: 0,
    tempStride5_in: 0,

    tempLoop0_out: 4,
    tempLoop1_out: 256,
    tempLoop2_out: 1,
    tempLoop3_out: 1,
    tempLoop4_out: 1,
    tempLoop5_out: 1,

    tempStride0_out: 64,
    tempStride1_out: 256,
    tempStride2_out: 0,
    tempStride3_out: 0,
    tempStride4_out: 0,
    tempStride5_out: 0,

    spatialStride_in: 8,
